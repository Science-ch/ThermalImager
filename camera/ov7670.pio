.program ov7670
.wrap_target

; set x, 25
; set y, 9
set x, 19
set y, 15

wait 1 pin 10        ; 等 HSYNC = 1（行开始）

pixel_loop:
    wait 1 pin 8     ; PCLK ↑
    in pins, 8 [9]
    in pins, 8
    push block
    wait 0 pin 8

    jmp x-- pixel_loop

set x, 19
jmp y-- pixel_loop

wait 0 pin 10

.wrap